---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Precio cerrado desde $350",
    description: "Publicamos los precios y te confirmamos el tuyo antes de ir. Sabés cuánto pagás antes de confirmar, no al terminar.",
    icon: "bx:bxs-badge-check",
  },
  {
    title: "En el día y sin recargo",
    description: "¿Lo necesitás hoy? Vamos hoy. No cobramos extra por urgencia; otros servicios cobran hasta $490 más por agenda express.",
    icon: "bx:bxs-time-five",
  },
  {
    title: "Traslado gratis en Montevideo",
    description: "El viaje está incluido en el precio, no es un cargo aparte como con otros armadores.",
    icon: "bx:bxs-home",
  },
  {
    title: "Garantía de 30 días",
    description: "Si algo no queda bien, volvemos y lo arreglamos sin costo. Así de simple.",
    icon: "bx:bxs-shield-alt-2",
  },
  {
    title: "Herramientas y experiencia",
    description: "Más de 500 muebles armados, de cualquier marca. Llegamos con todo: vos no ponés ni un destornillador.",
    icon: "bx:bxs-wrench",
  },
  {
    title: "Pagás al final",
    description: "En efectivo o Prex, recién cuando el mueble está armado, nivelado y revisado con vos.",
    icon: "bx:bxs-calendar-check",
  },
];
---

<div class="mt-16 md:mt-0 text-center">
  <h2 class="text-3xl lg:text-4xl font-bold lg:tracking-tight">
    Por qué elegirnos
  </h2>
  <p class="text-lg mt-4 text-slate-600">
    Todo esto está incluido en el precio. Con otros armadores, la mitad se cobra aparte.
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-16">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-black rounded-full p-2 w-8 h-8 shrink-0">
          <Icon class="text-white" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-xl">{item.title}</h3>
          <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
